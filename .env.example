# Frontend preview runs without credentials. Replace placeholders when connecting services.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_CLERK_SECRET_KEY
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
MONGODB_URI=mongodb://localhost:27017/datara
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=replace_with_model_name
TAVILY_API_KEY=replace_with_tavily_api_key
HF_TOKEN=replace_with_hugging_face_token
KAGGLE_USERNAME=replace_with_kaggle_username
