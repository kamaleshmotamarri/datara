# Frontend preview runs without credentials. Replace placeholders when connecting services.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_CLERK_SECRET_KEY
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
HF_TOKEN=replace_with_hugging_face_token
KAGGLE_USERNAME=replace_with_kaggle_username
KAGGLE_KEY=replace_with_kaggle_api_key
NEXT_PUBLIC_CAL_EVENT_URL=https://cal.com/your-team/consultation
CAL_WEBHOOK_SECRET=replace_with_webhook_secret
STORAGE_DIR=./storage

# Server
ADMIN_CLERK_USER_IDS=
TRAINING_PYTHON=.venv-train/bin/python
TRAINING_DOCKER=0
